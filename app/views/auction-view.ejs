<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Auction Item View</title>
        <link rel="stylesheet" type="text/css" href="/style/style.css">
        <link rel="stylesheet" type="text/css" href="/style/item-view.css">
    </head>
    <body>
        <!-- Universal Navigation Bar-->
        <%- include("navbar", { active }) %>
        <div id="auction-page" data-auction-id="<%= auctionID %>"></div>        
        <main>
            <div class="breadcrumb">
                breadcrumb placeholder
            </div>

            <div class="item-container">
                <!-- left: item img --> 
                <div class="item-img">
                    <img id="image" src="<%= itemDetails.image %>" alt="Item Image">
                </div>

                <!-- right: bid info and buttons -->
                <div class="item-info">
                    <h1><%= itemDetails.name %></h1>

                    <div class="bid-detail">
                        <p>Listed By @<%= auction.seller_username %></p>
                        <p> Current Highest bid</p>
                        <%
                            const displayPrice = Math.max(
                                Number(auction.current_highest_bid),
                                Number(auction.starting_price)
                            );
                        %>

                        <h1 id="curr-price">
                            <%= displayPrice.toLocaleString("en-US", {
                                style: "currency",
                                currency: "USD"
                            }) %>
                        </h1>
                        <div>
                            <h3>Place Your Bid</h3>
                            <input class="bid-amount" type="number" min="0.50" step="0.1" inputmode="decimal" placeholder="0.00" required>
                        </div>
                        <div id="message"></div>
                    </div>

                    <hr>
                    
                    <div class="buttons">
                        <button class="place-bid">
                            Place Bid
                        </button>
                        <button class="buy-now">
                            Buy Now
                        </button>
                    </div>
                </div>
            </div>
            <!-- bottom: description -->
            <div class="item-desc-section">
                <h3>About This Item</h3>
                <p id="item-desc">Item Description</p>
            </div>
        </main> 
        <script src="/socket.io/socket.io.js"></script>
        <script src="/js/auction-view.js"></script>
    </body>
</html>