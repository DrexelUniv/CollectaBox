<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Auction Item View</title>
        <link rel="stylesheet" type="text/css" href="/style/style.css">
        <link rel="stylesheet" type="text/css" href="/style/item-view.css">
    </head>
    <body>
        <%- include("navbar", { active }) %>
        <main>
            <div class="breadcrumb">
                breadcrumb placeholder
            </div>

            <div class="item-container">
                <!-- left: item img --> 
                <div class="item-img">
                    <img id="image" src="/images/placeholder.png" alt="Item Image">
                </div>

                <!-- right: bid info and buttons -->
                <div class="item-info">
                    <h1 id="item-name">Item Name</h1>

                    <div class="bid-detail">
                        <p id="seller-user">Listed By @username</p>
                        <p> Current Highest bid</p>
                        <h1 id="curr-price">$8.00</h1>
                        <div>
                            <h3>Place Your Bid</h3>
                            <input class="bid-amount" type="number" min="0.01" step="0.1" inputmode="decimal" placeholder="0.00" required>
                        </div>
                        <div id="message"></div>
                    </div>

                    <hr>
                    
                    <div class="buttons">
                        <button class="place-bid">
                            Place Bid
                        </button>
                        <button class="buy-now">
                            Buy Now
                        </button>
                    </div>
                </div>
            </div>
            <!-- bottom: description -->
            <div class="item-desc-section">
                <h3>About This Item</h3>
                <p id="item-desc">Item Description</p>
            </div>
        </main> 
        <script
            src="/js/auction-view.js">
        </script>
    </body>
</html>