<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>My Account</title>
    <link rel="stylesheet" href="/style/style.css" />
    <link rel="stylesheet" href="/style/account.css" />
</head>
<body>

<!-- Universal Navigation Bar -->
<%- include("navbar", { active }) %>

<main>
    <div id="profile-header">
        <img src="<%= account.profile_pic_id ? '/images/profile_' + account.profile_pic_id + '.png' : '/images/profile_pic_blank.png' %>"
             alt="Profile Picture" class="pfp-image"
             onerror="this.onerror=null; this.src='/images/profile_pic_blank.png'" />
        <div>
            <h1 id="user-name">@<%= account.username %></h1>
            <p id="email"><%= account.email %></p>
            <p id="bio"><%= account.bio || "No bio yet" %></p>
        </div>
    </div>

    <hr>

    <div id="profile-navigation">
        <h2>Profile Navigation</h2>
        <ul>
            <li><a href="/index">My Collection</a></li>
            <li><a href="/trade">Trade Requests</a></li>
            <li><a href="/listings">Listings &amp; Auctions</a></li>
            <li><a href="/settings">Settings</a></li>
        </ul>
    </div>
</main>

<script src="/js/account.js"></script>
</body>
</html>